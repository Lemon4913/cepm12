# Copy this file to .env and fill in real values.

# Postgres connection. Fill in the POSTGRES_* parts below — they're the same
# variable names the official `postgres` Docker image reads for its own setup
# (see docker-compose.yml), so this one file configures both the container
# and the app. Start it with: docker compose up -d
#
# If you're pointing at a managed provider instead of the local container,
# set DATABASE_URL directly and the POSTGRES_* parts below are ignored:
# DATABASE_URL=postgres://user:password@host:5432/dbname
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=talat_tha_na
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=talat_tha_na

# Random 32+ byte secret used to sign session cookies AND to hash email OTP
# codes. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Resend (https://resend.com) — sends the 6-digit sign-in code by email.
# Without this set, codes are printed to the server console instead of
# actually emailed (handy for local dev, never leave it unset in production).
RESEND_API_KEY=
# Must be a verified sender on your Resend account. The default below
# (onboarding@resend.dev) works out of the box without verifying a domain.
EMAIL_FROM="Talat Tha Na <onboarding@resend.dev>"

# Optional: created by `bun run db:seed` as the first admin account.
ADMIN_EMAIL=admin@talatthana.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin
