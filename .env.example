# Copy this file to .env and fill in real values.

# SQLite database file (relative to project root).
DATABASE_URL=app.sqlite

# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: created by `bun run db:seed` as the first admin account.
ADMIN_EMAIL=admin@talatthana.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin
