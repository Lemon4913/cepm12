# Copy this file to .env and fill in real values.

# SQLite database file (relative to project root, or an absolute path e.g.
# /data/app.sqlite if it lives on a mounted volume in production).
DATABASE_URL=app.sqlite

# Random 32+ byte secret used to sign session cookies AND to hash email OTP
# codes. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Resend (https://resend.com) — sends the 6-digit sign-in code by email.
# Without this set, codes are printed to the server console instead of
# actually emailed (handy for local dev, never leave it unset in production).
RESEND_API_KEY=
# Must be a verified sender on your Resend account. The default below
# (onboarding@resend.dev) works out of the box without verifying a domain.
EMAIL_FROM="Talat Tha Na <onboarding@resend.dev>"

# Optional: created by `bun run db:seed` as the first admin account.
ADMIN_EMAIL=admin@talatthana.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin
